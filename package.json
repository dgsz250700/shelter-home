{
  "name": "refugio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "setup:doctor": "node scripts/setup-doctor.mjs",
    "setup:remote": "node --env-file=.env.local scripts/setup-remote.mjs",
    "setup:verify": "node --env-file=.env.local lib/data/verify-connection.mjs",
    "student:add": "node --env-file=.env.local scripts/students.mjs add",
    "student:pin": "node --env-file=.env.local scripts/students.mjs pin",
    "setup:daniela": "pnpm setup:doctor && pnpm setup:remote && pnpm verify && pnpm exec vercel --prod --yes",
    "admin:password": "node --env-file=.env.local scripts/change-admin-password.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "google-auth-library": "^11.0.2",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vercel": "59.11.2",
    "vitest": "5.0.0"
  }
}
