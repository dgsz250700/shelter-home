# Local setup only. Never upload these two values to Vercel.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=
# Use the project's publishable key (legacy anon keys also work).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use the server-only secret/service-role key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
LAURA_EMAIL=estudiante@refugio.test
LAURA_PASSWORD=
TUTOR_EMAIL=tutor@refugio.test
TUTOR_PASSWORD=

# Server-only: tutor, memory and question generation
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Google Drive folder shared as "Anyone with the link" (no Google credentials needed)
GOOGLE_DRIVE_PUBLIC_FOLDER_ID=

# Private Google Drive PDF bank (server only)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Personal Google account connection (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this to https://YOUR-DOMAIN/api/tutor/drive/callback when Drive is enabled.
GOOGLE_REDIRECT_URI=
